# Application Environment (development, production)
APP_ENV=development
APP_NAME=Adhi's NST

# Security Secret Key (Generate a random 32-byte secret in production)
SECRET_KEY=dev-secret-key-please-change-in-production

# PyTorch Model Execution Device (auto, cpu, cuda)
MODEL_DEVICE=auto

# Model Weights Paths (Leave empty to use default NST_Code locations)
VGG_WEIGHTS_PATH=
DECODER_WEIGHTS_PATH=

# Inference and Upload Constraints
NST_IMAGE_SIZE=512
MAX_UPLOAD_MB=10

# Database & Supabase (For full-stack portfolio phase)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# Frontend and CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
