# Ignore environment and secret files
.env
.env.local
.env.*.local

# Virtual environments
.venv/
myenv/
venv/
ENV/

# Ignore macOS system files
.DS_Store
**/.DS_Store

# Ignore Python bytecode directories
__pycache__/
**/__pycache__/
*.pyc

# Local upload caches (preserve directory structure)
NST_Code/static/uploads/*
!NST_Code/static/uploads/.gitkeep

# IDE and scratch artifacts
artifacts/
scratch/
